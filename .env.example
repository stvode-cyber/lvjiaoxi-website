# 绿角犀官网 环境变量示例
# 本文件仅作说明。运行方式（任选其一）：
#   - PM2：在 deploy/ecosystem.config.js 的 env 中填写（推荐）
#   - systemd：在 deploy/lvjiaoxi.service 的 Environment= 中填写
#   - 直接运行：在启动命令前 export（如 `ADMIN_PASSWORD=xxx node server/server.js`）
#
# 注意：本应用内置零依赖 .env 加载器（server/env.js），启动时会自动读取本文件；
#       也可由 PM2 / systemd / 直接 export 注入，优先级更高。
#       请勿将真实口令提交到仓库，务必通过环境变量或进程管理器注入。

# 后台管理员口令（务必改为高强度口令，≥8 位，含大小写/数字/符号）
ADMIN_PASSWORD=change_me_strong_password

# Token 签名密钥（多管理员无状态 Token 签发/校验用，务必设置为强随机值）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：更换此值会使所有已签发 Token 立即失效（用户需重新登录）
AUTH_SECRET=change_me_64_hex_chars

# 服务监听端口
PORT=3000

# 站点正式域名（用于 sitemap / robots / OG / canonical，务必改为真实域名）
SITE_URL=https://lvjiaoxi.com
